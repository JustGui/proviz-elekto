# ============================================================================
# ProvizElekto - Environment Variables
# Copy to .env and fill in your values.
# ============================================================================

# ---------------------------------------------------------------------------
# Storage backend
# ---------------------------------------------------------------------------
# "sqlite" (default, zero-infra) or "postgres"
PROVIZ_STORAGE=sqlite

# SQLite: path to the database file (used when PROVIZ_STORAGE=sqlite)
PROVIZ_DB_PATH=./proviz.db

# PostgreSQL: full connection URL (used when PROVIZ_STORAGE=postgres)
# Can share an existing database - ProvizElekto uses pz_* prefixed tables.
# PROVIZ_DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Default: 0 (OS assigns an ephemeral port, printed to stdout as PROVIZ_PORT=<n> on startup).
# Set a fixed value only if you need a stable port (e.g. Docker, multi-process setups, firewall rules).
# PROVIZ_PORT=63130

# ---------------------------------------------------------------------------
# Docker / remote client
# ---------------------------------------------------------------------------
# When using the Python client alongside a containerised proviz-server, set
# these so ProvizElekto skips spawning a subprocess and attaches directly.
# PROVIZ_HOST=proviz    # Docker service name or remote hostname
# PROVIZ_PORT=63130     # Must match the port exposed by the container

# Rust log level (server binary)
# Options: error | warn | info | debug | trace
RUST_LOG=proviz_server=info,proviz_elekto_core=info

# ---------------------------------------------------------------------------
# OpenRouter auto-sync
# ---------------------------------------------------------------------------
# Seconds between automatic OpenRouter catalog syncs (fetch + upsert + reload). Runs once
# immediately at startup, then on this interval. No-op if providers/openrouter/brand.json
# isn't present. Default 3600 (1 hour).
# PROVIZ_OPENROUTER_SYNC_SECS=3600

# ---------------------------------------------------------------------------
# Requesty auto-sync
# ---------------------------------------------------------------------------
# Same behavior as PROVIZ_OPENROUTER_SYNC_SECS, for the requesty provider.
# PROVIZ_REQUESTY_SYNC_SECS=3600

# ---------------------------------------------------------------------------
# FX rates (per-brand price_currency -> USD normalisation)
# ---------------------------------------------------------------------------
# Endpoint for exchange-rate lookups (ECB via frankfurter.dev, "base=USD" shape). Fetched
# once at startup, then lazily (at most hourly) when a selection finds rates stale. Successful
# fetches are persisted to pz_fx_rates so last-good values survive restarts / offline periods.
# Only matters if any brand.json sets a non-USD "price_currency".
# PROVIZ_FX_BASE_URL=https://api.frankfurter.dev/v1/latest?base=USD

# ---------------------------------------------------------------------------
# Provider API keys
# These are read by YOUR application at call time via candidate.api_key_env.
# ProvizElekto itself never calls LLM APIs - it only tells you which model to use.
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
TOGETHER_API_KEY=...
OPENROUTER_API_KEY=sk-or-...
REQUESTY_API_KEY=...
# OLLAMA_BASE_URL=http://localhost:11434  # only needed if non-default

# Infomaniak AI Tools. INFOMANIAK_PRODUCT_ID is your account-specific "Ai-Tools"
# product id (GET https://api.infomaniak.com/1/ai) — the committed
# providers/infomaniak/brand.json stores it as a ${INFOMANIAK_PRODUCT_ID}
# placeholder in base_url, expanded from this env var at request time (server or
# Docker container). Required whenever an Infomaniak model can be selected.
INFOMANIAK_API_KEY=...
INFOMANIAK_PRODUCT_ID=00000
